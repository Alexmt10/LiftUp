<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/txtNombreUsuarioPostId"
        android:layout_width="280dp"
        android:layout_height="30dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:text="Alex22m22"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/ImgIconoPostId"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ImgPublicaionPostId"
        android:layout_width="match_parent"
        android:layout_height="415dp"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:layout_marginTop="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <ImageView
        android:id="@+id/ImgIconoPostId"
        android:layout_width="45dp"
        android:layout_height="39dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/materialDivider4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        app:layout_constraintTop_toBottomOf="@+id/ImgPublicaionPostId"
        tools:layout_editor_absoluteX="0dp" />

    <ImageView
        android:id="@+id/iconMegustaPostId"
        android:layout_width="32dp"
        android:layout_height="33dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ImgPublicaionPostId"
        app:srcCompat="@drawable/icon_corazon_transparente" />

    <ImageView
        android:id="@+id/iconMensajesPostId"
        android:layout_width="32dp"
        android:layout_height="33dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ImgPublicaionPostId"
        app:srcCompat="@drawable/icon_comentario" />

    <ImageView
        android:id="@+id/iconComidaPostId"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@+id/iconRutinaPostId"
        app:layout_constraintTop_toBottomOf="@+id/ImgPublicaionPostId"
        app:srcCompat="@drawable/icon_cubiertos" />

    <ImageView
        android:id="@+id/iconRutinaPostId"
        android:layout_width="31dp"
        android:layout_height="33dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ImgPublicaionPostId"
        app:srcCompat="@drawable/icon_mancuerna" />

    <TextView
        android:id="@+id/txtNumeroMegustaPostId"
        android:layout_width="61dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAlignment="textStart"
        android:text="12345"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/iconMegustaPostId"
        app:layout_constraintTop_toBottomOf="@+id/ImgPublicaionPostId" />

    <TextView
        android:id="@+id/txtComentarioPostId"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="20dp"
        android:textSize="16dp"
        android:text="TextView"
        app:layout_constraintBottom_toTopOf="@+id/materialDivider4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>