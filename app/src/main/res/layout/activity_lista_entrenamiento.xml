<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tipos.ListaEntrenamiento">


    <androidx.recyclerview.widget.RecyclerView
        android:paddingTop="50dp"
        android:id="@+id/recyclerListEntrenamientoId"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:listitem="@layout/item_entrenamiento"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatBtnAnadirEntrenamientoId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="60dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/icon_nueva" />

    <TextView
        android:id="@+id/textView6"
        style="@style/liftup_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/liftup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>